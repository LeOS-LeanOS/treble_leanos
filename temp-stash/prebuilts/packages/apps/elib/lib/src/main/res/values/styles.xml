<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ETheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/e_accent</item>
        <item name="android:statusBarColor">@color/e_action_bar</item>
        <item name="android:navigationBarColor">@color/e_action_bar</item>
        <item name="android:windowBackground">@color/e_background</item>
        <item name="android:windowLightStatusBar">@bool/isLight</item>
        <item name="android:windowLightNavigationBar">@bool/isLight</item>
        <item name="materialAlertDialogTheme">@style/ETheme.Dialog</item>
        <item name="materialButtonStyle">@style/ETheme.Button</item>
        <item name="floatingActionButtonStyle">@style/ETheme.Button.Floating</item>
        <item name="snackbarStyle">@style/ETheme.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/ETheme.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/ETheme.Snackbar.Button</item>
        <item name="toolbarStyle">@style/ETheme.Toolbar</item>
        <item name="actionOverflowButtonStyle">@style/ETheme.Toolbar.Overflow</item>
        <item name="actionOverflowMenuStyle">@style/ETheme.Toolbar.Popup</item>
        <item name="navigationViewStyle">@style/ETheme.NavigationDrawer</item>
        <item name="bottomNavigationStyle">@style/ETheme.BottomNavigation</item>
        <item name="switchStyle">@style/ETheme.Switch</item>
    </style>
    <style name="ETheme.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/e_floating_background</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
    <style name="ETheme.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/e_accent</item>
        <item name="android:textColor">@color/e_background</item>
    </style>
    <style name="ETheme.Button.Floating" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/e_accent</item>
        <item name="tint">@color/e_background</item>
    </style>
    <style name="ETheme.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/e_background_inverse</item>
        <item name="actionTextColorAlpha">1</item>
    </style>
    <style name="ETheme.Snackbar.Text" parent="Widget.MaterialComponents.Snackbar.TextView" >
        <item name="android:textColor">@color/e_background</item>
        <item name="android:alpha">1</item>
    </style>
    <style name="ETheme.Snackbar.Button" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/e_accent_inverse</item>
    </style>
    <style name="ETheme.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="materialThemeOverlay">@style/ETheme.Toolbar.Theme</item>
        <item name="navigationIconTint">@color/e_primary_text_color</item>
        <item name="titleTextColor">@color/e_primary_text_color</item>
        <item name="subtitleTextColor">@color/e_primary_text_color</item>
    </style>
    <style name="ETheme.Toolbar.Theme" parent="">
        <item name="colorPrimary">@color/e_action_bar</item>
        <item name="colorControlNormal">@color/e_icon_color</item>
    </style>
    <style name="ETheme.Toolbar.Overflow" parent="">
        <item name="android:src">@drawable/e_ic_more</item>
    </style>
    <style name="ETheme.Toolbar.Popup" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/popup_background</item>
    </style>
    <style name="ETheme.NavigationDrawer" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">@color/e_drawer_background</item>
        <item name="itemIconTint">@color/navigation_drawer_selector</item>
        <item name="itemTextColor">@color/navigation_drawer_selector</item>
        <item name="itemShapeFillColor">@color/navigation_drawer_item_background</item>
    </style>
    <style name="ETheme.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="backgroundTint">@color/e_action_bar</item>
        <item name="itemIconTint">@color/bottom_navigation_selector</item>
        <item name="itemTextColor">@color/bottom_navigation_selector</item>
    </style>
    <style name="ETheme.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="android:thumb">@drawable/e_switch_thumb</item>
        <item name="track">@drawable/e_switch_track</item>
    </style>
</resources>
