 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/target/product/aosp_arm.mk b/target/product/aosp_arm.mk
index c9e60d3..c01892f 100644
--- a/target/product/aosp_arm.mk
+++ b/target/product/aosp_arm.mk
