From 035c942c755595b8b22235dfbfef21ad9657395c Mon Sep 17 00:00:00 2001
From: harvey186 <harvey186@hotmail.com>
Date: Mon, 4 Aug 2025 16:58:52 +0100
Subject: [PATCH 6/10] Disable sending google our IMSI for AGPS

Change-Id: I458aeb467ad8bdebc58a2078c51fb5a58b373e45
---
 .../server/location/gnss/GnssLocationProvider.java        | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/location/gnss/GnssLocationProvider.java b/services/core/java/com/android/server/location/gnss/GnssLocationProvider.java
index 63bd9ab81..d6f906334 100644
--- a/services/core/java/com/android/server/location/gnss/GnssLocationProvider.java
+++ b/services/core/java/com/android/server/location/gnss/GnssLocationProvider.java
@@ -1808,6 +1808,12 @@ public class GnssLocationProvider extends AbstractLocationProvider implements
         int type = AGPS_SETID_TYPE_NONE;
         String setId = null;

+        /*
+         * We don't want to tell Google our IMSI or phone number to spy on us!
+         * As devices w/o SIM card also have working GPS, providing this data does
+         * not seem to add a lot of value, at least not for the device holder
+         *
+
         int subId = SubscriptionManager.getDefaultDataSubscriptionId();
         if (mGnssConfiguration.isActiveSimEmergencySuplEnabled() && mNIHandler.getInEmergency()
                 && mNetworkConnectivityHandler.getActiveSubId() >= 0) {
@@ -1828,7 +1834,7 @@ public class GnssLocationProvider extends AbstractLocationProvider implements
                 // This means the framework has the SIM card.
                 type = AGPS_SETID_TYPE_MSISDN;
             }
-        }
+        } */

         mGnssNative.setAgpsSetId(type, (setId == null) ? "" : setId);
     }
--
