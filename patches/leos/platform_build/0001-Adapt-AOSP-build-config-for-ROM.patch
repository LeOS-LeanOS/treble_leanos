From be0e1bba91106448b86286977cc46630962fb3da Mon Sep 17 00:00:00 2001
From: harvey186 <harvey186@hotmail.com>
Date: Mon, 4 Aug 2025 15:29:43 +0100
Subject: [PATCH 1/3] Adapt AOSP build config for ROM

Change-Id: I52abacd386275c1954091f60711153342ef4a661
---
 target/product/aosp_arm.mk                 | 1 +
 target/product/aosp_arm64.mk               | 1 +
 target/product/generic_system.mk           | 1 +
 target/product/security/PRESIGNED.pk8      | 0
 target/product/security/PRESIGNED.x509.pem | 0
 5 files changed, 3 insertions(+)
 create mode 100644 target/product/security/PRESIGNED.pk8
 create mode 100644 target/product/security/PRESIGNED.x509.pem

diff --git a/target/product/aosp_arm.mk b/target/product/aosp_arm.mk
index 595c3db..c01892f 100644
--- a/target/product/aosp_arm.mk
+++ b/target/product/aosp_arm.mk
@@ -27,6 +27,7 @@ PRODUCT_USE_DYNAMIC_PARTITIONS := true
 # All components inherited here go to system image
 #
 $(call inherit-product, $(SRC_TARGET_DIR)/product/generic_system.mk)
+$(call inherit-product, vendor/rom/base.mk)

 # Enable mainline checking for excat this product name
 ifeq (aosp_arm,$(TARGET_PRODUCT))
diff --git a/target/product/aosp_arm64.mk b/target/product/aosp_arm64.mk
index cd3de51..593dc5e 100644
--- a/target/product/aosp_arm64.mk
+++ b/target/product/aosp_arm64.mk
@@ -31,6 +31,7 @@
 #
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/generic_system.mk)
+$(call inherit-product, vendor/rom/base.mk)

 # Enable mainline checking for excat this product name
 ifeq (aosp_arm64,$(TARGET_PRODUCT))
diff --git a/target/product/generic_system.mk b/target/product/generic_system.mk
index 2482afc..a7ef65d 100644
--- a/target/product/generic_system.mk
+++ b/target/product/generic_system.mk
@@ -18,6 +18,7 @@
 $(call inherit-product, $(SRC_TARGET_DIR)/product/handheld_system.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/telephony_system.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/languages_default.mk)
+$(call inherit-product, vendor/rom/base.mk)
 # Add adb keys to debuggable AOSP builds (if they exist)
 $(call inherit-product-if-exists, vendor/google/security/adb/vendor_key.mk)

diff --git a/target/product/security/PRESIGNED.pk8 b/target/product/security/PRESIGNED.pk8
new file mode 100644
index 0000000..e69de29
diff --git a/target/product/security/PRESIGNED.x509.pem b/target/product/security/PRESIGNED.x509.pem
new file mode 100644
index 0000000..e69de29
--
2.49.0
