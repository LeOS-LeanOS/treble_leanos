diff --git a/src/com/android/settings/privacy/AdvancedPrivacyPreferenceController.java b/src/com/android/settings/privacy/AdvancedPrivacyPreferenceController.java
new file mode 100644
index 0000000..c2ad92f
--- /dev/null
+++ b/src/com/android/settings/privacy/AdvancedPrivacyPreferenceController.java
@@ -0,0 +1,36 @@
+package com.android.settings.privacy;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.ComponentName;
+import androidx.preference.Preference;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.R;
+
+public class AdvancedPrivacyPreferenceController extends BasePreferenceController {
+
+    public AdvancedPrivacyPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        preference.setIcon(R.drawable.ap); // Dein Icon
+        preference.setSummary(R.string.advanced_privacy_summary);
+        preference.setTitle(R.string.advanced_privacy_title);
+        preference.setOnPreferenceClickListener(pref -> {
+            Intent intent = new Intent();
+            intent.setComponent(new ComponentName(
+                "foundation.e.advancedprivacy",
+                "foundation.e.advancedprivacy.main.MainActivity"
+            ));
+            mContext.startActivity(intent);
+            return true;
+        });
+    }
+}
