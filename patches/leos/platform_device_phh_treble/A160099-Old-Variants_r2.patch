From fcdac3b72404542e882edcb85cc0ec0e74f5d753 Mon Sep 17 00:00:00 2001
From: harvey186 <harvey186@hotmail.com>
Date: Tue, 17 Jun 2025 20:02:13 +0200
Subject: [PATCH] difference

---
 generate.sh  | 8 +++++++-
 old-vndk.mk  | 1 +
 rw-system.sh | 5 +++++
 3 files changed, 13 insertions(+), 1 deletion(-)
 create mode 100644 old-vndk.mk

diff --git a/generate.sh b/generate.sh
index 461eff1..8f24152 100644
--- a/generate.sh
+++ b/generate.sh
@@ -15,7 +15,7 @@ fi
 echo 'PRODUCT_MAKEFILES := \' > AndroidProducts.mk
 
 for part in a ab;do
-	for apps in vanilla gapps foss gapps-go;do
+	for apps in vanilla gapps foss gapps-go old;do
 		for arch in arm64 arm a64;do
 			for su in yes no;do
 				apps_suffix=""
@@ -44,6 +44,12 @@ for part in a ab;do
 					apps_script=''
 					apps_name="vanilla"
 				fi
+				if [ "$apps" == "old" ];then
+					apps_suffix="y"
+					apps_script=''
+					apps_name="vanilla old"
+					optional_base='include device/phh/treble/old-vndk.mk'
+				fi
 				if [ "$arch" == "arm" ];then
 					vndk="vndk-binder32.mk"
 				fi
diff --git a/old-vndk.mk b/old-vndk.mk
new file mode 100644
index 0000000..522b81b
--- /dev/null
+++ b/old-vndk.mk
@@ -0,0 +1 @@
+PRODUCT_EXTRA_VNDK_VERSIONS := 28 29
diff --git a/rw-system.sh b/rw-system.sh
index a7b94f6..3e25c0b 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -380,6 +380,11 @@ mkdir -p /mnt/phh/
 mount -t tmpfs -o rw,nodev,relatime,mode=755,gid=0 none /mnt/phh || true
 mkdir /mnt/phh/empty_dir
 touch /mnt/phh/empty
+touch /mnt/phh/unreadable
+chmod 0 /mnt/phh/unreadable
+if [ "$vndk" -le 29 ]; then
+    mount /mnt/phh/unreadable /vendor/etc/seccomp_policy/configstore@1.1.policy
+fi
 fixSPL
 
 changeKeylayout
-- 
2.34.1
