// Privapp-permissions XML for LeOS-Launcher
prebuilt_etc {
    name: "privapp-permissions-com.leos.launcher.dev.xml",
    src: "privapp-permissions-com.leos.launcher.dev.xml",
    sub_dir: "permissions",
    installable: true,
}

// LeOS-Launcher APK
android_app_import {
    name: "LeOS-Launcher",
    apk: "LeOS-Launcher.apk",
    presigned: true,
    preprocessed: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    required: ["privapp-permissions-com.leos.launcher.dev.xml"],
}