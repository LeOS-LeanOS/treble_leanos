// Privapp-permissions XML for AdvancedPrivacy
prebuilt_etc {
    name: "privapp-permissions-foundation.e.advancedprivacy.xml",
    src: "privapp-permissions-foundation.e.advancedprivacy.xml",
    sub_dir: "permissions",
    installable: true,
}

// AdvancedPrivacy APK
android_app_import {
    name: "AdvancedPrivacy",
    apk: "AdvancedPrivacy.apk",
    certificate: "platform",
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    required: ["privapp-permissions-foundation.e.advancedprivacy.xml"],
}