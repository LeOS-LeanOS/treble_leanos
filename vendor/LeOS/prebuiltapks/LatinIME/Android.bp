// privapp-permissions XML-Datei
prebuilt_etc {
    name: "privapp-permissions-org.futo.inputmethod.latin.xml",
    src: "privapp-permissions-org.futo.inputmethod.latin.xml",
    sub_dir: "permissions",
}

// LatinIME APK
android_app_import {
    name: "LatinIME",
    apk: "latinime-stable-release.apk",
    privileged: false,
    certificate: "platform",
    overrides: ["Updater"],
//    enforce_uses_libraries: false, // Optional: nur falls relevant für deine API-Level, ansonsten weglassen
}

